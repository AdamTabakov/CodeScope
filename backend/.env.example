PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/codescope
JWT_SECRET=replace-with-a-long-random-string
JWT_ISSUER=codescope
JWT_AUDIENCE=codescope-web
JWT_EXPIRES_IN=1h
ADMIN_USERNAME=Adam
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_EMAIL=admin@example.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=https://codescope-4yq.pages.dev
APP_URL=http://localhost:3000
# Where the browser lands after a Google OAuth round-trip. In production the
# built frontend is served co-located, so this defaults to APP_URL.
FRONTEND_URL=http://localhost:5173
# Google OAuth. Create a project in https://console.cloud.google.com/ and add
# <APP_URL>/api/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=CodeScope <onboarding@resend.dev>
