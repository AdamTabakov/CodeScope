PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/codescope
JWT_SECRET=replace-with-a-long-random-string
JWT_ISSUER=codescope
JWT_AUDIENCE=codescope-web
JWT_EXPIRES_IN=1h
ADMIN_USERNAME=Adam
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_EMAIL=admin@example.com

# Comma-separated list of browser origins allowed to call this API (CORS).
# Never use "*" — the frontend sends Authorization headers, so only list
# the exact deployed frontend origin(s).
CORS_ORIGINS=https://codescope-4yq.pages.dev

# Email verification (Resend). Optional — without a key, verification links
# are printed to the backend console instead of emailed.
# APP_URL is the base URL users see in emailed verification links. In
# production this must be the deployed frontend URL, not localhost.
APP_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=CodeScope <onboarding@resend.dev>

# TESTING ONLY — email address(es) that may register more than once. Only the
# listed addresses bypass unique-email enforcement; everyone else stays unique.
# Never list real users. Requires redeploy so the partial index is recreated.
# ALLOW_DUPLICATE_EMAILS_FOR=adamtabakov40@gmail.com
